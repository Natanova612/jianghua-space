---
/**
 * 简历 —— 双轨版（2026-08 更新）
 * 求职意向改为双轨：独立经营顾问（主业）+ AI 产品运营岗位（开放）
 * 新增：独立顾问经历（某苏州文旅集团，脱敏）+ AI 能力画像（产出导向）
 * 全文双语；视觉换纸墨印 tokens。
 */
import HumanLayout from '../layouts/HumanLayout.astro';
import Lang from '../components/Lang.astro';
---

<HumanLayout title="简历 | 姜华" description="独立经营顾问 · 15年互联网产品及用户运营实战">
  <div class="max-w-4xl mx-auto px-6 py-16 md:py-24">

    {/* Header */}
    <header class="mb-16">
      <h1 class="font-human text-4xl md:text-5xl text-ink mb-4">姜华</h1>
      <p class="text-xl text-ink/70">
        <Lang zh="独立经营顾问 · 15年+互联网产品及用户运营实战" en="Independent Business Consultant · 15+ years in internet product & user operations" />
      </p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-3 text-sm text-ink/50">
        <span>18913138955（<Lang zh="微信同" en="WeChat same" />}）</span>
        <span>Faraway1314@163.com</span>
        <span><Lang zh="Base地不设限（现驻杭州）" en="Location-flexible (currently Hangzhou)" /></span>
        <span><Lang zh="硕士（悉尼科技大学）" en="Master's, UTS Sydney" /></span>
      </div>
    </header>

    {/* 当前方向（双轨） */}
    <section class="mb-16 p-6 md:p-8 rounded-[3px] border border-cinnabar/25 bg-cinnabar/[0.03]">
      <h2 class="font-human font-medium text-xl text-ink mb-5 flex items-center gap-3">
        <span class="w-8 h-8 rounded-[3px] bg-cinnabar/10 text-cinnabar flex items-center justify-center text-sm">01</span>
        <Lang zh="当前方向" en="Current Focus" />
      </h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <p class="text-sm font-medium text-cinnabar mb-2">
            <Lang zh="主业 · 独立经营顾问" en="Primary · Independent Consultant" />
          </p>
          <p class="text-sm text-ink/70 leading-7">
            <Lang
              zh="面向文旅 / 本地生活 / 产业互联网的中小企业与创业团队：经营诊断、产品策划、运营陪跑、数据化运营机制搭建。"
              en="For SMEs and startups in cultural tourism, local services, and industrial internet: business diagnosis, product strategy, operations partnering, data-driven operating systems."
            />
          </p>
        </div>
        <div>
          <p class="text-sm font-medium text-dai-blue mb-2">
            <Lang zh="开放 · AI 赛道岗位" en="Open to · AI-track Roles" />
          </p>
          <p class="text-sm text-ink/70 leading-7">
            <Lang
              zh="AI 产品 / AI 应用运营方向。有从 0 到 1 的 AI 产品操盘与商业化闭环经验（见 AI 能力画像）。"
              en="AI product / AI-applied operations roles. Hands-on 0→1 AI product leadership with commercial closure (see AI capability profile below)."
            />
          </p>
        </div>
      </div>
    </section>

    {/* 岗位匹配评估 → 已升级为首页对话（V2 M1：旧匹配器下线） */}
    <section class="mb-16 p-6 md:p-8 rounded-[3px] border border-dai-blue/25 bg-dai-blue/[0.03]">
      <h2 class="font-human font-medium text-xl text-ink mb-2 flex items-center gap-3">
        <span class="w-8 h-8 rounded-[3px] bg-dai-blue/10 text-dai-blue flex items-center justify-center text-sm">✦</span>
        <Lang zh="岗位匹配评估" en="JD Match Check" />
      </h2>
      <p class="text-sm text-ink/60 leading-7 mb-5 max-w-2xl">
        <Lang
          zh="想让 AI 分身评估岗位匹配度？它已搬到首页——去那里直接贴 JD，它会给出匹配度、带证据的匹配点，以及坦诚的差距判断。"
          en="Want the AI assistant to assess job fit? It now lives on the homepage — paste a JD there and it returns a match score, evidence-backed strengths, and honest gaps."
        />
      </p>
      <a
        href="/?intent=interview#ask"
        class="inline-flex items-center gap-2 px-6 py-3 bg-dai-blue text-paper rounded-[3px] font-medium text-sm hover:bg-dai-blue/90 transition-colors"
      >
        <Lang zh="去首页贴 JD →" en="Paste a JD on the homepage →" />
      </a>
    </section>

    {/* 核心能力总结 */}
    <section class="mb-16">
      <h2 class="font-human font-medium text-2xl text-ink mb-6 flex items-center gap-3">
        <span class="w-8 h-8 rounded-[3px] bg-cinnabar/10 text-cinnabar flex items-center justify-center text-sm">02</span>
        <Lang zh="核心能力总结" en="Core Strengths" />
      </h2>
      <p class="text-ink/80 mb-8 leading-7">
        <Lang
          zh="15年+实战，从同程艺龙的创业上市期到美团、蚂蚁集团的成熟期，覆盖 ToC 产品运营与商业化操盘。核心竞争力构建在四大支柱之上："
          en="15+ years across Tongcheng-Elong's startup-to-IPO era and the mature stages of Meituan and Ant Group, spanning consumer product operations and commercialization. Four pillars:"
        />
      </p>

      <div class="grid md:grid-cols-2 gap-4">
        <div class="p-6 rounded-[3px] border border-ink/10">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🎯</span>
            <h3 class="font-medium text-ink"><Lang zh="产品运营能力" en="Product Operations" /></h3>
          </div>
          <p class="text-sm text-ink/60 leading-7">
            <Lang
              zh="懂产品的运营操盘手。主导「动态打包」技术流程改造实现规模化扩张；在支付宝出行频道主导架构改版，显著提升流量分发效率。"
              en="An operator who understands product. Led the 'dynamic packaging' workflow rebuild enabling scale; led the Alipay travel channel revamp, lifting distribution efficiency."
            />
          </p>
        </div>

        <div class="p-6 rounded-[3px] border border-ink/10">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">📈</span>
            <h3 class="font-medium text-ink"><Lang zh="用户增长能力" en="User Growth" /></h3>
          </div>
          <p class="text-sm text-ink/60 leading-7">
            <Lang
              zh="深谙全生命周期管理，具备千万级用户增长模型实战经验。主导美团酒店会员体系从0到1重构；统筹线下获客专项，累计获取数千万新用户。"
              en="Full-lifecycle expertise with 10M+ user growth models. Rebuilt Meituan Hotel's membership system from scratch; led offline acquisition programs bringing tens of millions of new users."
            />
          </p>
        </div>

        <div class="p-6 rounded-[3px] border border-ink/10">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">💰</span>
            <h3 class="font-medium text-ink"><Lang zh="商业化变现能力" en="Monetization" /></h3>
          </div>
          <p class="text-sm text-ink/60 leading-7">
            <Lang
              zh="管理亿级流量的商业化变现。建立外部KA分销渠道接入规则；在存量博弈阶段通过精细化运营挖掘用户消费场景跃迁机会点。"
              en="Monetized traffic at the hundreds-of-millions scale. Built KA distribution channel rules; in the stock-game era, uncovered consumption-scenario upgrades through refined operations."
            />
          </p>
        </div>

        <div class="p-6 rounded-[3px] border border-ink/10">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🤖</span>
            <h3 class="font-medium text-ink"><Lang zh="AI 产品落地经验" en="AI Product Delivery" /></h3>
          </div>
          <p class="text-sm text-ink/60 leading-7">
            <Lang
              zh="主导支付宝「出行AI助手」专项，负责 Prompt 优化与场景定义，打通从用户咨询到服务购买的商业闭环。"
              en="Led Alipay's 'Travel AI Assistant': scenario definition and prompt optimization, closing the loop from user inquiry to purchase."
            />
          </p>
        </div>
      </div>
    </section>

    {/* AI 能力画像（新增：产出导向） */}
    <section class="mb-16">
      <h2 class="font-human font-medium text-2xl text-ink mb-6 flex items-center gap-3">
        <span class="w-8 h-8 rounded-[3px] bg-cinnabar/10 text-cinnabar flex items-center justify-center text-sm">03</span>
        <Lang zh="AI 能力画像" en="AI Capability Profile" />
      </h2>
