---
import Lang from './Lang.astro';

export interface Props {
  field?: 'human' | 'star';
}

const { field = 'human' } = Astro.props;
---

<footer class={`py-10 px-6 border-t ${field === 'star' ? 'border-gray-deep/30' : 'border-gray-200/60'}`}>
  <div class="max-w-4xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
    <div class="text-center md:text-left">
      {field === 'star' ? (
        <>
          <p class="text-sm font-medium font-mono text-aurora-blue">姜华 × 星河</p>
          <p class="text-xs mt-1 text-gray-light">人机协作舞台 · 持续演化中</p>
        </>
      ) : (
        <div class="flex items-center gap-3 justify-center md:justify-start">
          <img src="/seal.png" alt="姜华名章" class="w-8 h-8" width="32" height="32" />
          <div>
            <p class="text-sm font-medium font-human text-human-text">
              <Lang zh="姜华 · 独立经营顾问" en="Jiang Hua · Independent Consultant" />
            </p>
            <p class="text-xs mt-1 text-gray-light">
              <Lang zh="以 15 年互联网经验，提供咨询与运营陪跑" en="Consulting & operations partnering, built on 15 years in tech" />
            </p>
          </div>
        </div>
      )}
    </div>
    
    <div class="flex items-center gap-6">
      <a 
        href="https://github.com/Natanova612/jianghua-space" 
        target="_blank"
        class={`text-xs transition-colors ${field === 'star' ? 'text-gray-light hover:text-aurora-blue' : 'text-gray-light hover:text-aurora-green'}`}
      >
        GitHub
      </a>
      <a 
        href="/rss.xml" 
        class={`text-xs transition-colors ${field === 'star' ? 'text-gray-light hover:text-aurora-blue' : 'text-gray-light hover:text-aurora-green'}`}
      >
        RSS
      </a>
      {field !== 'star' && (
        <a
          href="/starfield"
          class="text-xs text-gray-light hover:text-aurora-blue transition-colors"
        >
          <Lang zh="星河" en="Starfield" />
        </a>
      )}
      <span class={`text-xs ${field === 'star' ? 'text-gray-pale' : 'text-gray-pale'}`}>
        © 2026
      </span>
    </div>
  </div>
</footer>
