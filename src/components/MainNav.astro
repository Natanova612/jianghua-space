---
/**
 * MainNav v3 —— 「卷首题签」式导航（2026-08-14，V2 M1 改版）
 *
 * 站点升级为「AI 对话为核心」：导航表达核心层（首页对话）与栏目层的关系。
 * 结构：01 首页(/) 02 案例志(/#cases) 03 思考集(/learning) 04 其人(/about)
 *      05 简历(/resume) 06 联系(/contact) + 中/EN 切换
 * 样式：mono 编号（JetBrains Mono）+ 当前页朱砂下划线（对齐原型题签顶栏）
 * - 案例志指向首页长卷锚点（#cases）；思考集暂指向 /learning（P3 重构为 /notes 后更新）
 * - starfield 入口移出主导航，footer 保留可达
 *
 * 设计理念：导航不是悬浮的 UI chrome，而是长卷起首的题签——
 * 加高（80px）、纸色底、与首屏连成一纸；滚动后收拢为淡色细条（墨线底边浮现）。
 */
import Lang from './Lang.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const navItems = [
  { href: '/', zh: '首页', en: 'Home' },
  { href: '/#cases', zh: '案例志', en: 'Cases' },
  { href: '/learning', zh: '思考集', en: 'Notes' },
  { href: '/about', zh: '其人', en: 'About' },
  { href: '/resume', zh: '简历', en: 'Résumé' },
  { href: '/contact', zh: '联系', en: 'Contact' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  if (href.startsWith('/#')) return false; // 锚点项不做高亮
  return pathname === href || pathname.startsWith(href + '/');
};
---

<header id="main-nav" class="sticky top-0 z-40">
  <nav class="nav-inner max-w-6xl mx-auto px-6 flex items-center justify-between">
    <!-- 题签：名章 + 姓名 + 小字定位 -->
    <a href="/" class="flex items-center gap-3 group">
      <img src="/seal.png" alt="" class="nav-seal w-10 h-10" width="40" height="40" />
      <span class="flex flex-col leading-none">
        <span class="font-human text-2xl font-bold tracking-wide text-ink group-hover:text-cinnabar transition-colors">姜华</span>
        <span class="mt-1 text-[10px] tracking-[0.2em] text-ink/40">
          <Lang zh="独立经营顾问" en="CONSULTANT" />
        </span>
      </span>
    </a>

    <!-- Desktop Nav：mono 编号 + 当前页朱砂下划线 -->
    <div class="hidden md:flex items-center gap-1">
      {navItems.map((item, i) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`flex items-baseline gap-1.5 px-3 py-2 text-[15px] tracking-wider transition-colors border-b-2 ${
              active
                ? 'text-cinnabar border-cinnabar'
                : 'text-ink/55 hover:text-ink border-transparent'
            }`}
          >
            <span class={`font-mono text-[9.5px] ${active ? 'text-cinnabar' : 'text-ink/40'}`}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <Lang zh={item.zh} en={item.en} />
          </a>
        );
      })}

      <span class="mx-3 h-5 w-px bg-ink/15"></span>
      <LanguageSwitcher />
    </div>

    <!-- Mobile：切换器 + 菜单按钮 -->
    <div class="md:hidden flex items-center gap-1">
      <LanguageSwitcher />
      <button
        id="main-nav-menu-btn"
        class="p-2 rounded-md"
        aria-label="菜单 Menu"
      >
        <svg class="w-6 h-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Menu -->
  <div id="main-nav-menu" class="hidden md:hidden border-t border-ink/10 px-6 py-4 space-y-1 bg-paper">
    {navItems.map((item, i) => (
      <a
        href={item.href}
        class="flex items-baseline gap-2 py-2.5 text-[15px] tracking-wider text-ink/70 hover:text-ink"
      >
        <span class="font-mono text-[9.5px] text-ink/40">{String(i + 1).padStart(2, '0')}</span>
        <Lang zh={item.zh} en={item.en} />
      </a>
    ))}
  </div>
</header>

<style>
  /* 题签 → 收拢：默认 80px 高、无框线（与首屏一纸）；
     滚动后 56px、纸色微透 + 墨线底边浮现 */
  #main-nav {
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  #main-nav .nav-inner {
    height: 5rem;
    transition: height 0.3s ease;
  }
  #main-nav .nav-seal {
    transition: width 0.3s ease, height 0.3s ease;
  }
  #main-nav.is-compact {
    border-bottom-color: rgba(31, 35, 40, 0.12);
    background-color: rgba(247, 243, 236, 0.92);
    backdrop-filter: blur(10px);
  }
  #main-nav.is-compact .nav-inner {
    height: 3.5rem;
  }
  #main-nav.is-compact .nav-seal {
    width: 1.75rem;
    height: 1.75rem;
  }
</style>

<script>
  // 滚动收拢 + 移动端菜单
  const header = document.getElementById('main-nav');
  const onScroll = () => {
    header?.classList.toggle('is-compact', window.scrollY > 24);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const btn = document.getElementById('main-nav-menu-btn');
  const menu = document.getElementById('main-nav-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
