          <ul class="space-y-2 text-sm text-ink/60">
            <li class="flex gap-2">
              <span class="text-cinnabar shrink-0">▸</span>
              <span><strong><Lang zh="某苏州文旅集团" en="A Suzhou cultural tourism group" /></strong><Lang zh="：经营诊断 + 产品策划 + 运营方案（进行中，脱敏）" en=": business diagnosis, product strategy and operations plan (ongoing, anonymized)" /></span>
            </li>
            <li class="flex gap-2">
              <span class="text-cinnabar shrink-0">▸</span>
              <span><Lang zh="个人教练与 AI 工作法咨询；国际中文教师证书（CTC）备考中" en="Personal coaching and AI-workflow consulting; CTC certification in progress" /></span>
            </li>
          </ul>
        </div>

        {/* 蚂蚁 */}
        <div class="relative pl-6 border-l-2 border-dai-blue/40">
          <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-dai-blue/20 border-2 border-dai-blue"></div>
          <div class="mb-2">
            <h3 class="text-lg font-medium text-ink"><Lang zh="蚂蚁集团 · 支付宝数字出行酒旅事业部" en="Ant Group · Alipay Digital Mobility & Travel" /></h3>
            <p class="text-sm text-ink/50"><Lang zh="平台运营专家 | 2024.07 — 2026 · 团队：10人" en="Platform Operations Expert | 2024.07 — 2026 · Team of 10" /></p>
