---
/**
 * 联系我 —— 按来意分流（2026-08 独立顾问门面）
 * 三种来意 → 邮件（mailto 预填主题）+ 即刻二维码；微信二维码待用户提供后补挂。
 * 旧版「问星河」Q&A 已随双生叙事退场。
 */
import HumanLayout from '../layouts/HumanLayout.astro';
import Lang from '../components/Lang.astro';

const intents = [
  {
    zhTitle: '企业经营顾问合作',
    enTitle: 'Business consulting',
    zhDesc: '经营诊断、产品策划、运营陪跑——说说你的业务现状和卡点。',
    enDesc: 'Diagnosis, product strategy, operations partnering — tell me about your business and where it hurts.',
    subject: '经营顾问咨询',
  },
  {
    zhTitle: '个人教练',
    enTitle: 'Personal coaching',
    zhDesc: '职业转型、引入 AI 工作方式——约一次 1v1 聊聊。',
    enDesc: 'Career transition or AI-enabled workflows — book a 1v1 conversation.',
    subject: '个人教练预约',
  },
  {
    zhTitle: '合伙人 / AI 赛道机会',
    enTitle: 'Partnership & AI roles',
    zhDesc: '合伙共建、AI 产品运营方向的岗位——附上你的想法或 JD。',
    enDesc: 'Co-building partnerships or AI product/operations roles — include your idea or the JD.',
    subject: '合作机会',
  },
];
---

<HumanLayout title="联系我" description="工作邀约、合作咨询、或者只是想聊聊——邮件与即刻均可直达。">

  <section class="scroll-reveal">
    <div class="max-w-3xl mx-auto px-6 pt-16 pb-20 md:pt-20">

      <h1 class="font-human font-medium text-3xl md:text-4xl text-ink mb-3">
        <Lang zh="联系我" en="Get in Touch" />
      </h1>
      <p class="text-ink/55 mb-12">
        <Lang
          zh="工作邀约、合作咨询、或者只是想聊聊——都欢迎。"
          en="Projects, collaborations, or just a conversation — all welcome."
        />
      </p>

      {/* 来意分流 */}
      <p class="text-sm text-ink/45 mb-6">
        <Lang zh="你是哪一种来意？点开直接写信，主题已替你拟好。" en="What brings you here? Pick one — the email subject is pre-filled." />
      </p>

      <div class="mb-14">
        {intents.map((it) => (
          <a
            href={`mailto:Faraway1314@163.com?subject=${encodeURIComponent(it.subject)}`}
            class="group flex items-start justify-between gap-6 py-6 border-t border-ink/10 last:border-b"
          >
            <div>
              <h2 class="font-human font-medium text-xl text-ink mb-1.5 group-hover:text-cinnabar transition-colors">
                <Lang zh={it.zhTitle} en={it.enTitle} />
              </h2>
              <p class="text-[15px] text-ink/60 leading-7 max-w-xl">
                <Lang zh={it.zhDesc} en={it.enDesc} />
              </p>
            </div>
            <span class="flex-none mt-1.5 inline-flex items-center gap-1.5 text-sm text-dai-blue group-hover:gap-2.5 transition-all">
              <Lang zh="写信" en="Write" />
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </span>
          </a>
        ))}
      </div>

      {/* 联系方式 */}
      <div class="flex flex-wrap items-stretch gap-4">
        {/* 邮箱（点击复制） */}
        <button
          id="copy-email"
          data-email="Faraway1314@163.com"
          class="inline-flex items-center gap-3 px-5 py-3 border border-ink/20 rounded-[3px] hover:border-cinnabar/50 transition-colors cursor-pointer text-left"
        >
          <span class="text-xl leading-none">✉️</span>
          <span>
            <span class="block text-xs text-ink/45 mb-0.5">
              <Lang zh="邮箱 · 点击复制" en="Email · click to copy" />
            </span>
            <span class="block font-mono text-sm text-ink">Faraway1314@163.com</span>
          </span>
        </button>

        {/* 即刻 */}
        <div class="inline-flex items-center gap-3 px-4 py-2.5 border border-ink/20 rounded-[3px]">
          <img src="/images/jike-qr.png" alt="即刻二维码" class="w-14 h-14 rounded-sm" width="56" height="56" />
          <span class="text-left leading-snug">
            <span class="block text-sm font-medium text-ink">
              <Lang zh="即刻" en="Jike" /> @Natanova
            </span>
            <span class="block text-xs text-ink/50 mt-0.5">
              <Lang zh="扫码加个好友" en="Scan to connect" />
            </span>
          </span>
        </div>

        {/* 微信（二维码待补） */}
        <div class="inline-flex items-center gap-3 px-5 py-3 border border-ink/10 rounded-[3px] text-left opacity-70">
          <span class="text-xl leading-none">💬</span>
          <span>
            <span class="block text-xs text-ink/45 mb-0.5">
              <Lang zh="微信" en="WeChat" />
            </span>
            <span class="block text-sm text-ink/60">
              <Lang zh="邮件或即刻索取" en="Ask via email or Jike" />
            </span>
          </span>
        </div>
      </div>

      <p id="copy-feedback" class="text-xs text-cinnabar mt-4 opacity-0 transition-opacity">
        <Lang zh="已复制到剪贴板" en="Copied to clipboard" />
      </p>

      <p class="mt-14 text-sm text-ink/45 leading-7 max-w-xl">
        <Lang
          zh="通常 24 小时内回复。直接最好——先给上下文，再提请求，不必寒暄。"
          en="I usually reply within 24 hours. Be direct — context first, then the ask. No small talk needed."
        />
      </p>
    </div>
  </section>

  <script>
    document.getElementById('copy-email')?.addEventListener('click', function () {
      const email = this.getAttribute('data-email');
      if (!email) return;
      navigator.clipboard.writeText(email).then(() => {
        const feedback = document.getElementById('copy-feedback');
        feedback?.classList.remove('opacity-0');
        setTimeout(() => feedback?.classList.add('opacity-0'), 2000);
      });
    });
  </script>

</HumanLayout>
