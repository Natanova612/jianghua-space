---
/**
 * 首页 v5 —— 「一纸长卷」精加工版（2026-08-05）
 *
 * 统一网格：全站内容同一条 768px 中轴，左缘对齐贯穿全卷。
 * 朱批系统：桌面端竖排落于右侧卷缘（xl），移动端收为文内横排小字。
 * 动效：名章盖印（首屏）、引首章盖印（滚动）、墨线生长、朱批显影。
 */
import HumanLayout from '../layouts/HumanLayout.astro';
import Lang from '../components/Lang.astro';
import ReadingDrift from '../components/ReadingDrift.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const services = [
  {
    zhTitle: '企业经营顾问', enTitle: 'Business Consulting',
    zhDesc: '面向文旅、本地生活、产业互联网方向的中小企业与创业团队：经营诊断、产品策划、运营陪跑、数据化运营机制搭建。',
    enDesc: 'For SMEs and startups in cultural tourism, local services and industrial internet: diagnosis, product strategy, operations partnering, data-driven operating systems.',
    zhTag: '主服务', enTag: 'Primary',
    href: '/contact', zhCta: '约聊合作', enCta: 'Start a conversation',
  },
  {
    zhTitle: '个人教练', enTitle: 'Personal Coaching',
    zhDesc: '面向职业转型期、想引入 AI 工作方式的个人，1v1 对话与陪跑。',
    enDesc: '1v1 coaching for people in career transition or adopting AI-enabled ways of working.',
    zhTag: null, enTag: null,
    href: '/contact', zhCta: '预约详谈', enCta: 'Book a chat',
  },
  {
    zhTitle: '对外汉语', enTitle: 'Mandarin Teaching',
    zhDesc: '面向在华外籍人士与海外学习者的中文教学。CTC 备考中，敬请期待。',
    enDesc: 'Mandarin teaching for expats and overseas learners. CTC certification in progress.',
    zhTag: '筹备中', enTag: 'Coming soon',
    href: null, zhCta: null, enCta: null,
  },
];

const cases = [
  {
    zhTitle: '文旅项目经营诊断与方案', enTitle: 'Cultural Tourism: Diagnosis & Strategy',
    zhDesc: '为某苏州文旅集团提供经营诊断、产品策划与运营方案。脱敏案例，完整复盘整理中。',
    enDesc: 'Business diagnosis and operations strategy for a Suzhou cultural tourism group. Anonymized; full write-up in progress.',
    zhTag: '经营顾问', enTag: 'Consulting',
    href: null, zhCta: '整理中', enCta: 'In progress',
  },
  {
    zhTitle: 'AI 店长 · 商业计划', enTitle: 'AI Store Manager · Business Plan',
    zhDesc: '一个完整的 AI 应用商业计划：从洞察、产品设计到财务模型。',
    enDesc: 'A full business plan for an AI product: insight, product design, and financial model.',
    zhTag: 'AI 实战', enTag: 'AI in Practice',
    href: '/businessidea/number1/', zhCta: '查看', enCta: 'View',
  },
  {
    zhTitle: '湿地博物馆 · AI 讲解员助手', enTitle: 'Wetland Museum · AI Docent',
    zhDesc: '基于官方资料的展厅讲解内容系统，覆盖多个展厅的沉浸式导览。',
    enDesc: 'An exhibit-guide content system built on official museum materials.',
    zhTag: 'AI 实战', enTag: 'AI in Practice',
    href: '/wetland-museum/', zhCta: '查看', enCta: 'View',
  },
];

/* 「在读」书单已从首页撤下（阅读气息由字层表达），数据存档：
   《不连续的时代》德鲁克 / 《孔子与论语》钱穆 / 《具身智能》刘云浩，
   各配一句批注，备 /notes 重构（P3）时取用。详见 8/5、8/6 日志。 */
---

<HumanLayout title="姜华 · 独立经营顾问" description="姜华 —— 独立经营顾问。以 15 年互联网产品及用户运营、管理经验为基础，向企业和个人提供咨询与运营陪跑服务。">

  {/* 底层「画」：富春山居图卷轴，320s 往返横移 */}
  <div class="landscape-layer" aria-hidden="true"></div>

  {/* 中层「字」：读书划线轮播，190s 线性单向（与画轴异速异律） */}
  <ReadingDrift />

  {/* ===== 卷首 ===== */}
  <section class="relative">
    <div class="max-w-3xl mx-auto px-6 pt-16 pb-10 md:pt-20">
      <div class="flex items-end gap-4 mb-8">
        <h1 class="font-human text-7xl md:text-8xl lg:text-9xl text-ink leading-none tracking-wide">
          <Lang zh="姜华" en="Jiang Hua" />
        </h1>
        <img src="/seal.png" alt="姜华名章" class="seal-stamp w-12 h-12 md:w-16 md:h-16 mb-1 md:mb-2" width="64" height="64" />
      </div>

      <div class="space-y-3">
        <p class="opacity-0 animate-fade-in-up font-human text-2xl md:text-3xl text-cinnabar font-medium" style="animation-delay: 150ms;">
          <Lang zh="独立经营顾问" en="Independent Business Consultant" />
        </p>
        <p class="opacity-0 animate-fade-in-up text-lg md:text-xl text-ink/80" style="animation-delay: 450ms;">
          <Lang zh="15 年互联网产品及用户运营、管理经验" en="15 years in internet product & user operations leadership" />
        </p>
        <p class="opacity-0 animate-fade-in-up text-lg md:text-xl text-ink/80" style="animation-delay: 750ms;">
          <Lang zh="向企业和个人提供咨询与运营陪跑服务" en="Consulting and operations partnering for companies and individuals" />
        </p>
      </div>
    </div>
  </section>

  {/* ===== 承接段 ===== */}
  <section class="scroll-reveal">
    <div class="max-w-3xl mx-auto px-6 pb-20">
      <p class="font-human text-xl md:text-2xl text-ink/85 leading-relaxed">
        <Lang zh="职业生涯的前 15 年，" en="In the first 15 years of my career," />
      </p>
      <p class="mt-3 text-base md:text-lg text-ink/60 leading-relaxed">
        <Lang
          zh="我持续练习和沉淀的技能，就是我的职业标签。"
          en="the skills I kept practicing and refining have become my professional identity."
        />
      </p>
    </div>
  </section>

  {/* ===== 卷一「所愿」 ===== */}
  <section id="services" class="scroll-reveal">
    <div class="max-w-3xl mx-auto px-6 pb-20 relative">

      <div class="flex items-center gap-4 mb-4">
        <div class="chapter-seal flex-none w-9 h-14 bg-cinnabar rounded-[3px] shadow-[0_2px_8px_rgba(200,57,31,0.3)] flex flex-col items-center justify-center gap-1" style="--seal-rot: -2deg;" aria-hidden="true">
          <span class="text-paper text-sm leading-none font-human">所</span>
          <span class="text-paper text-sm leading-none font-human">愿</span>
        </div>
        <p class="font-human font-medium text-2xl md:text-3xl text-ink/90">
          <Lang zh="现在我想做的事" en="What I want to do now" />
        </p>
      </div>

      <div class="mt-8">
        {services.map((s) => {
          const inner = (
            <>
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-2">
                <h3 class={`font-human font-medium text-xl md:text-2xl ${s.href ? 'text-ink group-hover:text-cinnabar transition-colors' : 'text-ink/50'}`}>
                  <Lang zh={s.zhTitle} en={s.enTitle} />
                </h3>
                {s.zhTag && (
                  <span class={`text-xs ${s.href ? 'text-cinnabar' : 'text-ink/40'}`}>
                    <Lang zh={s.zhTag} en={s.enTag!} />
                  </span>
                )}
              </div>
              <p class={`text-[15px] md:text-base leading-7 max-w-xl ${s.href ? 'text-ink/60' : 'text-ink/40'}`}>
                <Lang zh={s.zhDesc} en={s.enDesc} />
              </p>
            </>
          );
          return s.href ? (
            <a href={s.href} class="group flex items-start justify-between gap-6 py-7 border-t border-ink/10 last:border-b">
              <div>{inner}</div>
              <span class="flex-none mt-2 inline-flex items-center gap-1.5 text-sm text-dai-blue group-hover:gap-2.5 transition-all">
                <Lang zh={s.zhCta!} en={s.enCta!} />
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </a>
          ) : (
            <div class="flex items-start justify-between gap-6 py-7 border-t border-ink/10 last:border-b">
              <div>{inner}</div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* ===== 卷二「所为」 ===== */}
  <section id="cases" class="scroll-reveal">
    <div class="max-w-3xl mx-auto px-6 pb-20 relative">

      <div class="flex items-center gap-4 mb-4">
        <div class="chapter-seal flex-none w-9 h-14 bg-cinnabar rounded-[3px] shadow-[0_2px_8px_rgba(200,57,31,0.3)] flex flex-col items-center justify-center gap-1" style="--seal-rot: 1.5deg;" aria-hidden="true">
          <span class="text-paper text-sm leading-none font-human">所</span>
          <span class="text-paper text-sm leading-none font-human">为</span>
        </div>
        <p class="font-human font-medium text-2xl md:text-3xl text-ink/90">
          <Lang zh="已经做了什么" en="What I have done" />
        </p>
      </div>

      <div class="mt-8">
        {cases.map((c) => {
          const inner = (
            <>
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mb-2">
                <h3 class={`font-human font-medium text-xl md:text-2xl ${c.href ? 'text-ink group-hover:text-cinnabar transition-colors' : 'text-ink/70'}`}>
                  <Lang zh={c.zhTitle} en={c.enTitle} />
                </h3>
                <span class="text-xs text-dai-blue">
                  <Lang zh={c.zhTag} en={c.enTag} />
                </span>
              </div>
              <p class="text-[15px] md:text-base leading-7 text-ink/60 max-w-xl">
                <Lang zh={c.zhDesc} en={c.enDesc} />
              </p>
            </>
          );
          return c.href ? (
            <a href={c.href} class="group flex items-start justify-between gap-6 py-7 border-t border-ink/10 last:border-b">
              <div>{inner}</div>
              <span class="flex-none mt-2 inline-flex items-center gap-1.5 text-sm text-dai-blue group-hover:gap-2.5 transition-all">
                <Lang zh={c.zhCta!} en={c.enCta!} />
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </a>
          ) : (
            <div class="flex items-start justify-between gap-6 py-7 border-t border-ink/10 last:border-b">
              <div>{inner}</div>
              <span class="flex-none mt-2 text-sm text-ink/35">
                <Lang zh={c.zhCta!} en={c.enCta!} />
              </span>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  {/* ===== 卷三「所学」 ===== */}
  <section class="scroll-reveal">
    <div class="max-w-3xl mx-auto px-6 pb-20 relative">

      <div class="flex items-center gap-4 mb-4">
        <div class="chapter-seal flex-none w-9 h-14 bg-cinnabar rounded-[3px] shadow-[0_2px_8px_rgba(200,57,31,0.3)] flex flex-col items-center justify-center gap-1" style="--seal-rot: -1deg;" aria-hidden="true">
          <span class="text-paper text-sm leading-none font-human">所</span>
          <span class="text-paper text-sm leading-none font-human">学</span>
        </div>
        <p class="font-human font-medium text-2xl md:text-3xl text-ink/90">
          <Lang zh="我还在学习思考的事" en="What I am still learning and thinking about" />
        </p>
      </div>

      <div class="mt-8">
        {posts.map((post) => (
          <a href={`/learning/${post.slug}/`} class="group flex items-baseline justify-between gap-6 py-6 border-t border-ink/10 last:border-b">
            <div>
              <h3 class="font-human font-medium text-lg md:text-xl text-ink mb-1.5 group-hover:text-cinnabar transition-colors leading-snug">
                {post.data.title}
              </h3>
              <p class="text-sm text-ink/55 leading-relaxed line-clamp-2 max-w-xl">
                {post.data.description}
              </p>
            </div>
            <time class="flex-none text-xs text-ink/40 font-mono mt-1">
              {post.data.pubDate.toISOString().slice(0, 10)}
            </time>
          </a>
        ))}
      </div>

      <div class="mt-8 text-right">
        <a href="/learning" class="text-sm text-dai-blue hover:underline underline-offset-4">
          <Lang zh="全部文章 →" en="All notes →" />
        </a>
      </div>
    </div>
  </section>

  {/* ===== 卷末「所期」：我想跟这样的你聊一下 ===== */}
  <section class="scroll-reveal">
    <div class="max-w-3xl mx-auto px-6 pb-28 relative">

      <div class="flex items-center gap-4 mb-4">
        <div class="chapter-seal flex-none w-9 h-14 bg-cinnabar rounded-[3px] shadow-[0_2px_8px_rgba(200,57,31,0.3)] flex flex-col items-center justify-center gap-1" style="--seal-rot: 1deg;" aria-hidden="true">
          <span class="text-paper text-sm leading-none font-human">所</span>
          <span class="text-paper text-sm leading-none font-human">期</span>
        </div>
        <p class="font-human font-medium text-2xl md:text-3xl text-ink/90">
          <Lang zh="我想跟这样的你聊一下" en="I'd love to hear from you, if —" />
        </p>
      </div>

      <div class="mt-10 mb-14 space-y-4 font-human text-lg md:text-xl text-ink/75 leading-relaxed max-w-2xl">
        <p>
          <Lang
            zh="你看好入境游、文旅方向，想把经验变成有意义的事；"
            en="You believe in inbound tourism and cultural travel, and want to turn experience into something meaningful;"
          />
        </p>
        <p>
          <Lang
            zh="你正面临职业或方向的困惑，想找个树洞说说；"
            en="You're at a career crossroads and want someone to talk it through with;"
          />
        </p>
        <p>
          <Lang
            zh="又或者，只是对这个站点背后的人有点好奇。"
            en="Or you're simply curious about the person behind this site."
          />
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4 mb-20">
        <a
          href="mailto:Faraway1314@163.com"
          class="inline-flex items-center gap-2 px-7 py-3.5 bg-cinnabar text-paper rounded-[3px] font-medium text-sm hover:bg-cinnabar/90 transition-colors shadow-[0_2px_12px_rgba(200,57,31,0.25)]"
        >
          Faraway1314@163.com
        </a>
        <div class="inline-flex items-center gap-3 px-4 py-2.5 border border-ink/20 rounded-[3px]">
          <img src="/images/jike-qr.png" alt="即刻二维码" class="w-14 h-14 rounded-sm" width="56" height="56" />
          <span class="text-left leading-snug">
            <span class="block text-sm font-medium text-ink">
              <Lang zh="即刻" en="Jike" /> @Natanova
            </span>
            <span class="block text-xs text-ink/50 mt-0.5">
              <Lang zh="扫码加个好友" en="Scan to connect" />
            </span>
          </span>
        </div>
      </div>

      {/* 题跋（草稿，待用户改定） */}
      <div class="mb-14 text-center font-kai text-base md:text-lg leading-loose text-ink/75">
        <Lang>
          <div slot="zh">
            <p>操盘十五年，见惯起落，始信慢功夫。</p>
            <p>今为独立顾问，以 AI 为杖，向文旅而行。</p>
            <p>读书、写字、做事、陪跑。</p>
            <p>若你也在路上，不妨同行一程。</p>
          </div>
          <div slot="en" class="font-serif-en italic">
            <p>Fifteen years at the helm taught me to trust slow work.</p>
            <p>Now an independent consultant — AI as my staff, cultural travel as my heading.</p>
            <p>Reading, writing, building, accompanying.</p>
            <p>If you're on the road too, walk with me a while.</p>
          </div>
        </Lang>
      </div>

      {/* 落款 */}
      <div class="flex flex-col items-center gap-3" aria-hidden="true">
        <img src="/seal.png" alt="" class="w-11 h-11" width="44" height="44" />
        <span class="font-human text-sm text-ink/45 tracking-[0.3em]">岁次丙午夏 · 姜华 谨识</span>
      </div>

      {/* 土壤厚度：真实阅读数据，随时间变厚（数据源：微信读书，手动更新） */}
      <p class="mt-12 text-center text-xs text-ink/35 tracking-wider">
        <Lang
          zh="土壤：212 本笔记的书 · 2,621 条划线 · 3 篇文章 · 仍在生长"
          en="The soil: 212 annotated books · 2,621 highlights · 3 essays · still growing"
        />
      </p>
    </div>
  </section>

</HumanLayout>
