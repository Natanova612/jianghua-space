        </div>
      </div>
    </section>

    {/* 工作经历 */}
    <section class="mb-16">
      <h2 class="font-human font-medium text-2xl text-ink mb-6 flex items-center gap-3">
        <span class="w-8 h-8 rounded-[3px] bg-cinnabar/10 text-cinnabar flex items-center justify-center text-sm">04</span>
        <Lang zh="工作经历" en="Experience" />
      </h2>

      <div class="space-y-10">
        {/* 独立顾问 */}
        <div class="relative pl-6 border-l-2 border-cinnabar/40">
          <div class="absolute -left-[9px] top-0 w-4 h-4 rounded-full bg-cinnabar/20 border-2 border-cinnabar"></div>
          <div class="mb-2">
            <h3 class="text-lg font-medium text-ink"><Lang zh="独立经营顾问" en="Independent Business Consultant" /></h3>
            <p class="text-sm text-ink/50"><Lang zh="2026 — 至今 · 杭州" en="2026 — present · Hangzhou" /></p>
